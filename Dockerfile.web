# EpisodicAI Web — Monorepo-aware Dockerfile
# Build from the REPO ROOT: gcloud run deploy episodic-ai-web --source .
# Uses the pre-built static export in apps/web/out/

# ─── Build Stage ─────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app

COPY package*.json ./
COPY packages/ ./packages/
COPY apps/web/ ./apps/web/

RUN npm install --legacy-peer-deps
RUN npm run build --workspace=apps/web

# ─── Run Stage (nginx serves the static out/) ────────────────────────────────
FROM nginx:alpine AS runner

# Copy the built static export
COPY --from=builder /app/apps/web/out /usr/share/nginx/html

# nginx config for SPA routing
RUN printf 'server {\n\
    listen 8080;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
    location ~* \\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {\n\
        expires 1y;\n\
        add_header Cache-Control "public, immutable";\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
