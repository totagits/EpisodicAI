# EpisodicAI Web — Environment Variables
# Copy this file to .env.local and fill in the values.
# These are safe to expose in the browser (NEXT_PUBLIC_ prefix).

# ─── Firebase Web SDK Config ───────────────────────────────────────────────────
# Get these from: Firebase Console → Project Settings → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=episodiai.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=episodiai
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=episodiai.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=838124124356
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here

# ─── API URL ───────────────────────────────────────────────────────────────────
# For local dev, leave as localhost. For production builds, use the Cloud Run URL.
NEXT_PUBLIC_API_URL=https://episodic-ai-api-26273727080.us-central1.run.app

# ─── Stripe Publishable Key (browser-safe) ─────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_key_here
